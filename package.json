{
  "name": "fast-ignore-rs",
  "repository": "github:fabiospampinato/fast-ignore",
  "description": "A Rust-powered fast parser and processor for .gitignore files.",
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fast-ignore-rs.*.node",
    "fast-ignore-rs-loader.cjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "fast-ignore-rs"
  },
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "napi build --platform --release --output-dir native-build && node tasks/copy-native.mjs",
    "build:ts": "tsc --project tsconfig.json",
    "clean": "node tasks/clean.mjs",
    "test": "npm run build && npm run test:rust && npm run typecheck && node --test test/index.test.mjs test/upstream.test.mjs test/compatibility.test.mjs",
    "typecheck": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict --skipLibCheck test/types.test.ts",
    "test:rust": "cargo test",
    "benchmark": "npm run build && node --expose-gc tasks/benchmark.mjs",
    "benchmark:prepare": "npm install --ignore-scripts",
    "prepublishOnly": "npm run build",
    "release:prepare": "npm run build && napi prepublish -t npm"
  },
  "keywords": [
    "fast",
    "gitignore",
    "dotignore",
    "ignore",
    "rust",
    "napi"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^3.5.0",
    "@types/node": "^22.10.0",
    "fast-ignore-original": "npm:fast-ignore@2.0.0",
    "typescript": "^5.9.3"
  }
}
